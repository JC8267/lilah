# Provider selection: anthropic | gemini | openai | openrouter | ollama | openai_compatible
LLM_PROVIDER=anthropic

# Model id for selected provider
MODEL_ID=claude-sonnet-4-20250514

# Keys (use LLM_API_KEY as the generic default; provider-specific keys are optional)
LLM_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional override for OpenAI-compatible base URL.
# Examples:
# - Gemini (OpenAI-compatible): https://generativelanguage.googleapis.com/v1beta/openai
# - OpenAI: https://api.openai.com/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Ollama: http://localhost:11434/v1
LLM_BASE_URL=

LLM_MAX_TOKENS=4096
LLM_MAX_ITERATIONS=10
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=1.0
# Gemini/OpenAI-compatible reasoning effort (empty disables explicit setting).
# Supported values: minimal | low | medium | high
LLM_REASONING_EFFORT=minimal
# If true, retries step up one level (for example minimal -> low -> medium).
LLM_REASONING_ESCALATE_ON_RETRY=true
# Optional comma-separated fallback model IDs, in order.
# Example: gemini-2.5-flash,gemini-2.0-flash
LLM_FALLBACK_MODELS=

# Question matching quality controls
QUESTION_MATCH_MODEL_ASSIST=true
QUESTION_MATCH_MODEL_TOP_K=8
QUESTION_MATCH_MODEL_MIN_CONFIDENCE=0.55
QUESTION_MATCH_MODEL_TIMEOUT_SECONDS=12

# Security controls for user-supplied runtime options and payload size
ALLOW_LLM_OVERRIDE=false
CHAT_HISTORY_MAX_MESSAGES=10
CHAT_REQUEST_MAX_BYTES=65536
CHAT_MESSAGE_MAX_CHARS=4000
CHAT_FILTERS_MAX_ITEMS=12
CHAT_FILTER_KEY_MAX_CHARS=80
CHAT_FILTER_VALUE_MAX_CHARS=200
CHAT_RATE_LIMIT_PER_MINUTE=30
CHAT_MAX_ACTIVE_STREAMS_PER_CLIENT=2
CHAT_MAX_ACTIVE_STREAMS_GLOBAL=40
CHAT_DISCONNECT_POLL_MS=300

MAX_QUERY_ROWS=200

# CORS
# Comma-separated explicit origins (no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Regex for dynamic preview domains (defaults to all vercel.app subdomains).
CORS_ALLOW_ORIGIN_REGEX=https://.*\\.vercel\\.app
